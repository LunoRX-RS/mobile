<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keep playing with the screen locked or the app in the background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Dynamic Island / lock-screen card; the widget extension lives in src-tauri/ios/LiveActivity. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Audio is handed to AVPlayer as a file URL, or as http://127.0.0.1 when the disk cache is off. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
