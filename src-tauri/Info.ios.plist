<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keep playing with the screen locked or the app in the background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Share links: lunorx://share/{token} opens the app (see commands/share.rs). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>io.lunorx.mobile.share</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lunorx</string>
			</array>
		</dict>
	</array>
	<!-- Audio is handed to AVPlayer as a file URL, or as http://127.0.0.1 when the disk cache is off. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
