{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "allow-library-likes",
    "allow-library-set-like",
    "allow-library-artist",
    "allow-library-album",
    "allow-search-query",
    "allow-search-cancel",
    "allow-providers-list",
    "allow-provider-credential-set",
    "allow-provider-credential-status",
    "allow-provider-credential-clear",
    "allow-youtube-connect",
    "allow-youtube-connect-finish",
    "allow-youtube-connection-status",
    "allow-youtube-import",
    "allow-youtube-import-playlist-from-url",
    "allow-shared-link-take",
    "allow-shared-playlist-get",
    "allow-shared-token-from-url",
    "allow-youtube-disconnect",
    "allow-youtube-like-push-get",
    "allow-youtube-like-push-set",
    "allow-remote-start",
    "allow-remote-stop",
    "allow-remote-send",
    "allow-sync-sign-in",
    "allow-sync-sign-out",
    "allow-sync-discard-pending",
    "allow-sync-status",
    "allow-sync-create-local-playlist",
    "allow-sync-add-local-entry",
    "allow-sync-upload-playlist",
    "allow-sync-list-local-playlists",
    "allow-sync-check-playlists",
    "allow-sync-set-playlist-description",
    "allow-sync-playlist-entries",
    "allow-sync-delete-local-playlist",
    "allow-sync-rename-local-playlist",
    "allow-sync-move-local-entry",
    "allow-telemetry-get",
    "allow-telemetry-set",
    "allow-telemetry-record",
    "allow-telemetry-flush",
    "allow-telemetry-delete",
    "allow-stats-local",
    "allow-stats-report",
    "allow-stats-clear-local",
    "allow-stats-set-cloud",
    "allow-stats-cloud-sync",
    "allow-stats-cloud-clear",
    "allow-sync-remove-local-entry",
    "allow-sync-flush-pending",
    "allow-sync-register",
    "allow-youtube-import-playlist-from-url",
    "allow-podcast-browse",
    "allow-shared-link-take",
    "allow-shared-playlist-get",
    "allow-shared-token-from-url",
    "allow-sync-share-playlist",
    "allow-sync-list-shares",
    "allow-sync-revoke-share",
    "allow-sync-resolve-conflict",
    "allow-player-audio-settings",
    "allow-player-set-audio-settings",
    "allow-player-effect-presets",
    "allow-player-state",
    "allow-player-progress",
    "allow-player-track-info",
    "allow-player-load",
    "allow-player-play",
    "allow-player-pause",
    "allow-player-resume",
    "allow-player-stop",
    "allow-player-skip",
    "allow-player-set-mode",
    "allow-player-queue-edit",
    "allow-player-queue-more",
    "core:webview:allow-set-webview-zoom",
    "allow-player-seek",
    "allow-player-set-volume",
    "allow-player-observe",
    "allow-player-open-external",
    "allow-offline-status",
    "allow-offline-keep",
    "allow-offline-cancel",
    "allow-offline-remove",
    "allow-offline-set-limit",
    "allow-offline-usage",
    "allow-offline-clear-transient",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.youtube.com/*"
        }
      ]
    },
    "allow-library-history",
    "allow-library-clear-history",
    "allow-discovery-feed",
    "allow-discovery-genres",
    "allow-fonts-installed",
    "allow-discord-settings-get",
    "allow-discord-settings-set",
    "allow-search-suggestions",
    "allow-lrc-load",
    "allow-lrc-save",
    "allow-lrc-delete",
    "allow-lrc-reveal",
    "allow-lrc-list",
    "allow-lyrics-source-fetch",
    "allow-lyrics-source-search",
    "allow-lyrics-source-bind",
    "allow-lyrics-source-unbind",
    "allow-lyrics-settings-get",
    "allow-lyrics-settings-set"
  ]
}
